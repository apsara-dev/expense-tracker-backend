# ==========================================
# FinTrack Email SMTP Configuration (Gmail)
# ==========================================
# To send real emails to inboxes using Gmail:
# 1. Go to Google Account -> Security -> 2-Step Verification (Turn ON).
# 2. Search "App passwords" -> Create one with name "FinTrack".
# 3. Paste your 16-character app password below:

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_digit_app_password
DEFAULT_FROM_EMAIL=FinTrack <your_email@gmail.com>

# CI/CD Webhook Secret (Set the same secret in GitHub Repository -> Settings -> Webhooks)
DEPLOY_SECRET=your_secret_deploy_key_here
